// EasyWay Tourism Platform - PostgreSQL Production Schema
// Use this schema when deploying against a PostgreSQL database instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         String            @default("USER") // USER | GUIDE | ADMIN
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  preferences  TravelPreference?
  reviews      Review[]
  favorites    Favorite[]
  trips        Trip[]
  inquiries    Inquiry[]
  guideProfile Guide?

  @@index([email])
  @@index([role])
}

model TravelPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCategories      String
  preferredRegions         String
  budgetRange              String
  travelGroupType          String
  preferredActivities      String
  accommodationPreferences String
  preferredDuration        String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Destination {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  state           String
  region          String
  description     String
  imageUrl        String
  categories      String
  latitude        Float
  longitude       Float
  bestTimeToVisit String?
  popularityScore Float?       @default(4.5)
  isPublished     Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attractions     Attraction[]
  hotels          Hotel[]
  reviews         Review[]
  favorites       Favorite[]
  tripItems       TripItem[]

  @@index([slug])
  @@index([region])
  @@index([state])
}

model Attraction {
  id                     String      @id @default(cuid())
  name                   String
  slug                   String      @unique
  destinationId          String
  destination            Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  description            String
  category               String
  imageUrl               String
  address                String?
  latitude               Float
  longitude              Float
  estimatedVisitDuration String?
  isPublished            Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  reviews                Review[]
  favorites              Favorite[]
  tripItems              TripItem[]

  @@index([slug])
  @@index([destinationId])
  @@index([category])
}

model Hotel {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  destinationId      String
  destination        Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  description        String
  accommodationType  String
  imageUrl           String
  address            String
  amenities          String
  latitude           Float
  longitude          Float
  contactInformation String?
  isPublished        Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  reviews            Review[]
  favorites          Favorite[]

  @@index([slug])
  @@index([destinationId])
  @@index([accommodationType])
}

model Guide {
  id              String    @id @default(cuid())
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  biography       String
  languages       String
  specializations String
  serviceRegions  String
  profileImageUrl String
  experienceYears Int?      @default(5)
  isPublished     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviews         Review[]
  favorites       Favorite[]

  @@index([serviceRegions])
}

model Review {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId    String?
  destination      Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attractionId     String?
  attraction       Attraction?  @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  hotelId          String?
  hotel            Hotel?       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guideId          String?
  guide            Guide?       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String
  moderationStatus String       @default("APPROVED")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
  @@index([destinationId])
  @@index([attractionId])
  @@index([hotelId])
  @@index([guideId])
}

model Favorite {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attractionId  String?
  attraction    Attraction?  @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  hotelId       String?
  hotel         Hotel?       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guideId       String?
  guide         Guide?       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([destinationId])
  @@index([attractionId])
  @@index([hotelId])
  @@index([guideId])
}

model Trip {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   String?
  endDate     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items       TripItem[]

  @@index([userId])
}

model TripItem {
  id            String       @id @default(cuid())
  tripId        String
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  attractionId  String?
  attraction    Attraction?  @relation(fields: [attractionId], references: [id], onDelete: SetNull)
  dayNumber     Int          @default(1)
  sortOrder     Int          @default(0)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tripId])
}

model Inquiry {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientType String
  recipientId   String?
  name          String
  email         String
  message       String
  travelDate    String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([recipientType])
  @@index([status])
}
